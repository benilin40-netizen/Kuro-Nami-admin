# ============================================================================
# KURO NAMI ADMIN — Standalone Administration Environment Configuration
# ============================================================================
# IMPORTANT: Do NOT commit real secrets to version control.
# Private API keys and storage credentials are read strictly on the server
# and are never exposed to browser clients.

# Application Server
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Database & Local Asset Staging Storage
ADMIN_SQLITE_PATH="./data/kuro-nami-admin.sqlite"
ADMIN_UPLOADS_DIR="./data/uploads"

# Security & Session Signing
SESSION_HMAC_SECRET="REPLACE_WITH_64_BYTE_RANDOM_HEX_SECRET"
SESSION_TTL_HOURS=24
# Optional one-time setup authorization token required during initial owner provisioning if set:
ADMIN_PROVISIONING_TOKEN=""

# ============================================================================
# Upstream Main KURO NAMI Platform Integration (Future / Controlled Connection)
# ============================================================================
KURO_NAMI_UPSTREAM_BASE_URL=""
KURO_NAMI_UPSTREAM_API_KEY=""
KURO_NAMI_UPSTREAM_HMAC_SECRET=""

# ============================================================================
# Streaming Provider Server-Side Credentials (Never exposed to frontend)
# ============================================================================
PROVIDER_ANIMEPAHE_API_KEY=""
PROVIDER_VCDN_API_KEY=""
PROVIDER_MEDIACM_API_KEY=""
PROVIDER_COORENLABS_API_KEY=""

# ============================================================================
# Storage Pool Server-Side Credentials (Referenced by prefix per server)
# Example: For prefix "R2_PRIMARY", set R2_PRIMARY_ACCESS_KEY_ID & R2_PRIMARY_SECRET_ACCESS_KEY
# ============================================================================
STORAGE_DEFAULT_ACCESS_KEY_ID=""
STORAGE_DEFAULT_SECRET_ACCESS_KEY=""

# Platform Runtime Variables
GEMINI_API_KEY=""
